INTERLOCK_API_BASE_URL=http://backend:8000
POSTGRES_DB=interlock
POSTGRES_USER=interlock
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional when running the backend outside Compose:
# DATABASE_URL=postgresql+psycopg://interlock:replace-with-a-local-password@localhost:5432/interlock
# Module 15 bounded evidence planning. Missing/invalid model configuration
# safely falls back to the existing deterministic evidence workflow.
INTERLOCK_ORCHESTRATOR_MODE=bounded_llm
INTERLOCK_ORCHESTRATOR_MODEL=gpt-5.5
INTERLOCK_ORCHESTRATOR_TIMEOUT_SECONDS=30
# OPENAI_API_KEY=<set locally; never commit a real key>
